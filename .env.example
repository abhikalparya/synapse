# Copy to `.env` in the repo root or in `backend/` (both paths are loaded).

# Which LLM provider handles every ingest/expand/audit/reshape/quiz/ask call.
# One of: openai (default), gemini, openai_compatible
LLM_PROVIDER=openai

# --- openai ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# --- gemini ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- openai_compatible (self-hosted or third-party endpoints that speak the OpenAI wire format) ---
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_API_KEY=

# Optional Synapse tuning
# Topics at or below this confidence get flagged "needs_review" instead of auto-rejected.
# ROADMAP_REVIEW_CONFIDENCE_THRESHOLD=0.6

# Product generation strategy (default: baseline). Do not set closed experiments here.
# Allowed: baseline | domain_curriculum_prior | domain_prior_edge_classifier
# SYNAPSE_GENERATION_STRATEGY=baseline
# SYNAPSE_CURRICULUM_DOMAIN=databases
