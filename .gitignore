# Environment and secrets (never commit real keys)
.env
.env.*
!.env.example
backend/.env
backend/.env.*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Node / frontend build
frontend/node_modules/
frontend/dist/

# OS and editors
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# Local runtime data (ingested notes + generated wiki — personal / bulky)
backend/raw_notes/*
!backend/raw_notes/.gitkeep
backend/wiki_pages/*
!backend/wiki_pages/.gitkeep

# Local runtime data (topic/dependency/proposal store, pre-SQLite JSON and the SQLite
# db + snapshots alike — personal / bulky, never shared state)
backend/topics/
backend/proposals/
backend/data/*
!backend/data/.gitkeep

# Logs and misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.cursorignore